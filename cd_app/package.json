{
  "name": "christian-doctrine-app",
  "version": "0.1.0",
  "private": true,
  "description": "Deploy scripts for the Christian Doctrine app (Flutter web + FastAPI on the VPS).",
  "scripts": {
    "deploy": "bash deploy/deploy.sh all",
    "deploy:web": "bash deploy/deploy.sh web",
    "deploy:api": "bash deploy/deploy.sh api",
