# Copy to .env and fill in. Never commit the real .env.

# Claude subscription auth. Generate with:  claude setup-token
# This is a 1 year OAuth token, NOT an ANTHROPIC_API_KEY.
BD_APP_CLAUDE_CODE_OAUTH_TOKEN=

# Google Sign-In. Create an OAuth client in Google Cloud Console.
# Add every client ID the Flutter app uses (Android, iOS, web) comma separated.
BD_APP_GOOGLE_CLIENT_IDS=

# Only these emails may sign in. All of them should be your own accounts.
BD_APP_ALLOWED_EMAILS=you@gmail.com,you@work.com

# Shared secret checked before Google identity. Generate 32+ random chars:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BD_APP_APP_BEARER_TOKEN=

# Doctrine engine (bd_mcp). Leave default if it runs on the same host.
BD_APP_MCP_URL=http://127.0.0.1:8765/mcp
BD_APP_MCP_SERVER_NAME=christian-doctrine

# Repo root, so read only tools can reach the data stores and sessions group.
BD_APP_ENGINE_CWD=/srv/christian-doctrine

# Optional model override.
# BD_APP_MODEL=claude-opus-4-8
