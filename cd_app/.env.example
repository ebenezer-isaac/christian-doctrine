# Copy to .env on the VPS next to docker-compose.yml. Never commit the real .env.

# Claude subscription auth. Generate on the VPS (browser step):  claude setup-token
# 1 year OAuth token, NOT an ANTHROPIC_API_KEY. Do not also set ANTHROPIC_API_KEY.
CD_APP_CLAUDE_CODE_OAUTH_TOKEN=

# Google Sign-In. Create an OAuth client in Google Cloud Console.
# Comma separated client IDs the app uses (web + android).
CD_APP_GOOGLE_CLIENT_IDS=

# Only these emails may sign in. All should be your own accounts.
CD_APP_ALLOWED_EMAILS=you@gmail.com,you@work.com

# Shared secret, must equal the app's APP_BEARER_TOKEN dart-define.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CD_APP_APP_BEARER_TOKEN=

# MongoDB (existing llmconveyors-mongodb on llmconveyors_app-network).
# Dedicated user for the christian_doctrine db (see deploy/README.md).
CD_APP_MONGO_URL=mongodb://cd_app:CHANGEME@llmconveyors-mongodb:27017/christian_doctrine?authSource=christian_doctrine
CD_APP_MONGO_DB=christian_doctrine

# Doctrine engine (bd_mcp -> cd_mcp) MCP over HTTP. Bridged to the local engine
# over Tailscale until the engine is migrated onto the VPS.
CD_APP_MCP_URL=http://100.101.156.2:8765/mcp
CD_APP_MCP_SERVER_NAME=christian-doctrine

# Working dir for the agent inside the container.
CD_APP_ENGINE_CWD=/work
