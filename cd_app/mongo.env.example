# Copy to mongo.env next to docker-compose.yml on the server (mode 600). Never commit the real mongo.env.
# Read by the mongodb service on first start of an empty volume.
#   openssl rand -hex 24
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=
# Password for the cd_app user; must match the one in CD_APP_MONGO_URL in .env.
CD_APP_MONGO_PASSWORD=
